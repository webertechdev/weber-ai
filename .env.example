# Backend
GROQ_API_KEY=replace_with_your_groq_key
# Managed option. Used as primary when present.
BROWSERBASE_API_KEY=replace_with_your_browserbase_key
# Optional self-hosted Playwright worker. When both are configured, Weber retries
# Browserbase quota/transient failures against this worker automatically.
BROWSER_WORKER_URL=https://browser-worker.example.com
BROWSER_WORKER_TOKEN=replace_with_a_long_random_worker_token
GROQ_MODEL=openai/gpt-oss-20b
AUTH_SECRET=replace_with_a_long_random_secret
# Use a managed Postgres URL in production; SQLite is for local development only.
DATABASE_URL=sqlite:///./webare_ai.db

# Frontend
# Leave empty on Vercel so the frontend uses the same-origin /api route.
NEXT_PUBLIC_API_URL=
